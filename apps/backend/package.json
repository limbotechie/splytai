    "@types/node": "^25.6.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.9"
